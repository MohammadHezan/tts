# Copy to .env and fill in only what the providers you selected in config.yaml need.
# Never commit the real .env file.

# Required only when translator.provider: claude in config.yaml
ANTHROPIC_API_KEY=

# Ollama local translator (translator.provider: ollama) usually needs no key.
# Override only if your Ollama instance sits behind an authenticating proxy.
OLLAMA_BASE_URL=http://localhost:11434

# Meeting Interpreter (bot that joins Zoom/Meet) - see README "Meeting Interpreter".
# Where your Attendee install's API is, as reachable from the translator.
# Attendee on this same machine + translator in docker compose:
#   ATTENDEE_BASE_URL=http://host.docker.internal:8000
ATTENDEE_BASE_URL=
# Created in Attendee's own web UI, under "API Keys".
ATTENDEE_API_KEY=
# Where Attendee's bot should connect back to for audio - must be reachable
# from wherever Attendee runs. Use this machine's LAN IP, e.g.:
#   ATTENDEE_CALLBACK_WS_URL=ws://192.168.1.50:8765/attendee/ws
ATTENDEE_CALLBACK_WS_URL=

# Documented extension points for future cloud ASR/TTS providers (not used in Phase 1).
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

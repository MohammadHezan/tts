<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed dark theme per spec ("Big readable text, dark theme") - not
         DayNight, since a live-conversation aid should stay legible and
         consistent regardless of the phone's system theme setting. -->
    <style name="Theme.Interpreter" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>

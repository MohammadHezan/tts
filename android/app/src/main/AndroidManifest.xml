<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic capture and streaming to the engine over the LAN. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Routing capture/playback to the Buds 3 Pro and preferring LE Audio. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Keeps the mic session + WebSocket connection alive while backgrounded
         (switching apps mid-conversation must not drop the call). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package-visibility: lets SpeechRecognizer (standalone
         mode's on-device ASR) find the system recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:theme="@style/Theme.Interpreter"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: the engine is a ws:// (not wss://) service on
             your LAN by default - see README "Setup" for a TLS/wss:// option
             if you expose it beyond a trusted local network. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Interpreter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.InterpreterForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />

    </application>

</manifest>
